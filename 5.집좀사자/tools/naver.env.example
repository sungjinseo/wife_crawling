# tools/naver.env 로 복사해서 쓰세요 (run_naver.sh 가 읽음)
SERVER=ubuntu@서버IP                     # 업로드할 서버 (비우면 수집만)
REMOTE_DIR=/data/docker/getting-home     # 서버의 프로젝트 폴더 → 파일은 그 아래 data/ 로 올라감
SSH_KEY=                                 # 기본 키(~/.ssh/id_ed25519, id_rsa)면 비워 둠. 다른 키면 경로 (예: ~/.ssh/oracle.key)
SSH_PORT=22
RETRIES=3                                # 네이버가 막았을 때 다시 시도할 횟수
RETRY_WAIT_MIN=40                        # 다시 시도 전 기다릴 시간(분)
KEEP_DAYS=30                             # 로그 보관 기간
