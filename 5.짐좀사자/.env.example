# 이 파일을 .env 로 복사한 뒤 값을 채우세요 (git 에 올리지 마세요)
DATA_GO_KR_KEY=공공데이터포털_일반인증키
VWORLD_KEY=브이월드_인증키
VWORLD_DOMAIN=
RONE_KEY=R-ONE_인증키
# 한국은행 ECOS (ecos.bok.or.kr 에서 무료 발급). 비워 두면 공개 샘플 키로 느리게 받음
ECOS_KEY=

# 브리핑 주소 (Traefik 라우팅), 기본 인증 (setup.sh 가 생성, 반드시 작은따옴표로 감쌀 것)
BRIEFING_HOST=home.greatseo.dev
BRIEFING_AUTH=

# 브리핑 HTML 을 쓸 폴더, 공공 수집 시각, 브리핑 확인 주기(분)
OUTPUT_PATH=./output
PUBLIC_AT=06:00
CHECK_MIN=10
# 연도별 비교용 실거래 기간(개월), 금리·지수 시작월
TRADE_MONTHS=120
HISTORY_FROM=200601
